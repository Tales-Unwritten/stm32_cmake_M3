{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "selftest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "FLASH_SELFTEST": "ON"
            }
        },
        {
            "name": "dma_selftest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DMA_SELFTEST": "ON"
            }
        },
        {
            "name": "i2c_wdt_selftest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "I2C_WDT_SELFTEST": "ON"
            }
        },
        {
            "name": "can_selftest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CAN_SELFTEST": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "selftest",
            "configurePreset": "selftest"
        },
        {
            "name": "dma_selftest",
            "configurePreset": "dma_selftest"
        },
        {
            "name": "i2c_wdt_selftest",
            "configurePreset": "i2c_wdt_selftest"
        },
        {
            "name": "can_selftest",
            "configurePreset": "can_selftest"
        }
    ]
}